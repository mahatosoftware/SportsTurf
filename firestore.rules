             (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('startDate' in data) || data.startDate == null || data.startDate is timestamp || (data.startDate is string && data.startDate.size() <= 50)) &&
             (!('endDate' in data) || data.endDate == null || data.endDate is timestamp || (data.endDate is string && data.endDate.size() <= 50)) &&
             (!('registrationStart' in data) || data.registrationStart == null || data.registrationStart is timestamp || (data.registrationStart is string && data.registrationStart.size() <= 50)) &&
             (!('registrationEnd' in data) || data.registrationEnd == null || data.registrationEnd is timestamp || (data.registrationEnd is string && data.registrationEnd.size() <= 50)) &&
             (!('status' in data) || data.status == null || (data.status is int && data.status >= 0 && data.status <= 10) || (data.status is string && data.status.size() <= 30)) &&
             (!('tournamentIds' in data) || (data.tournamentIds is list && data.tournamentIds.size() <= 500)) &&
             (!('rulesConfig' in data) || data.rulesConfig == null || (data.rulesConfig is map && data.rulesConfig.size() <= 50));

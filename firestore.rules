             (!('statusName' in data) || data.statusName == null || (data.statusName is string && data.statusName.size() <= 50)) &&
             (!('startDate' in data) || data.startDate == null || data.startDate is timestamp || (data.startDate is string && data.startDate.size() <= 50)) &&

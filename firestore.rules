             data.scoreA is int && data.scoreA >= 0 &&
             data.scoreB is int && data.scoreB >= 0 &&
             data.winner is string && data.winner.size() <= 100 &&
             (!('id' in data) || data.id == null || (data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == matchId)) &&
             (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 20000)) &&

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.sport is string && data.sport.size() >= 1 && data.sport.size() <= 50 &&
             (data.date is timestamp || (data.date is string && data.date.size() <= 50)) &&
             data.teamA is string && data.teamA.size() >= 1 && data.teamA.size() <= 100 &&

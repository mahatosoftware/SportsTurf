             (!('statusReason' in data) || data.statusReason == null || (data.statusReason is string && data.statusReason.size() <= 500)) &&
             (!('refereeId' in data) || data.refereeId == null || (data.refereeId is string && data.refereeId.size() <= 128)) &&
             (!('refereeUserIds' in data) || (data.refereeUserIds is list && data.refereeUserIds.size() <= 20)) &&
             (!('assignedScorerId' in data) || data.assignedScorerId == null || (data.assignedScorerId is string && data.assignedScorerId.size() <= 128)) &&
             (!('scorerUserIds' in data) || (data.scorerUserIds is list && data.scorerUserIds.size() <= 20)) &&
             (!('liveMatchData' in data) || data.liveMatchData == null || (data.liveMatchData is map && data.liveMatchData.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Domain validator for /teams/{teamId}

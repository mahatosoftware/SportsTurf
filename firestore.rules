rules_version = '2';

// ===============================================================
// Assumed Data Model & 9-Level RBAC Hierarchy
// ===============================================================
//
// 1. Platform Super Admin (Platform level)
//    - Verified via Auth token custom claims:
//      request.auth.token.admin == true ||
//      request.auth.token.superAdmin == true ||
//      request.auth.token.role == 'super_admin'
//    - Unrestricted management across all platform resources, leagues,
//      tournaments, venues, seasons, registrations, disputes, audit logs.
//
// 2. League Owner (League level)
//    - Creator of league (creatorId == auth.uid) or in ownerIds list.
//    - Full ownership over league branding, settings, visibility, appointing
//      league admins/owners, and deleting the league. Inherits tournament,
//      season, venue, registration, and dispute management under this league.
//
// 3. League Administrator (League level)
//    - In adminUserIds on the league document.
//    - Manages league operations: hosted tournaments, seasons, venues, fixtures,
//      registrations, descriptions, dates, and status. Cannot escalate permissions
//      or delete league.
//
// 4. Tournament Manager (Tournament level)
//    - Tournament creator (creatorId == auth.uid), or listed in managerUserIds,
//      or an owner/admin of the parent league (via leagueId document lookup).
//    - Full management over brackets, courts, schedules, participant seeds,
//      registrations, disputes, and appointing match referees and scorers.
//
// 5. Referee / Match Official (Match level)
//    - Listed in refereeUserIds on match or tournament, or refereeId / assignedRefereeId.
//    - Verifies match proceedings, confirms readiness, approves score corrections,
//      records disputes and walkovers (statusReason, status, winner), reviews disputes.
//
// 6. Scorer (Match level)
//    - Listed in scorerUserIds on match or tournament, or assignedScorerId / scorerId.
//    - Operates live scoreboards: can update scoreA, scoreB, sets, winner,
//      liveMatchData, and advance match status (upcoming -> live -> completed).
//      Strictly restricted to scoring fields; cannot tamper with metadata or delete records.
//
// 7. Team Manager / Captain (Team level)
//    - Team captain (captainId == auth.uid) or creator/manager (userId == auth.uid).
//    - Manages team roster (playerIds), colors, emblems, and submits team registrations.
//
// 8. Player / Participant (Participant level)
//    - Player profile owner (userId == auth.uid).
//    - Manages personal player profile, avatar, seed, and submits personal registrations.
//
// 9. Spectator / Viewer (Read only)
//    - Read-only access to discoverable leagues, tournaments, brackets,
//      fixtures, matches, teams, venues, seasons, and player rosters. Never permitted to write.
//
// ---------------------------------------------------------------
// Document Schemas & Field Constraints:
// ---------------------------------------------------------------
//
// Collection: /tournaments/{tournamentId}
// Document ID: Tournament UUID string (1-128 chars, matches tournament.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - creatorId: string (required, 1-128 chars, immutable)
//   - name: string (required, 1-100 chars)
//   - sportType: string (required, 1-50 chars)
//   - format: int (required, 0-10)
//   - formatName: string (optional, 0-50 chars)
//   - participants: list of maps (required, max 200 items)
//   - matches: list of maps (required, max 1000 items)
//   - status: int (required, 0-10)
//   - statusName: string (optional, 0-50 chars)
//   - seeded: bool (optional)
//   - createdAt: timestamp | string (required, max 50 chars, immutable)
//   - shareCode: string (required, 4-30 chars, immutable)
//   - isPublic: bool (required)
//   - participantUserIds: list of strings (optional, max 500 items)
//   - description: string (optional, max 5000 chars)
//   - organizerName: string (optional, max 100 chars)
//   - venue: string (optional, max 200 chars)
//   - venueId: string (optional, max 128 chars)
//   - startDate: timestamp | string (optional, max 50 chars)
//   - endDate: timestamp | string (optional, max 50 chars)
//   - bannerUrl: string (optional, max 2000 chars)
//   - registrationDeadline: timestamp | string (optional, max 50 chars)
//   - isTeamTournament: bool (optional)
//   - maxSquadSize: int (optional, 1-1000)
//   - minParticipants: int (optional, >= 0)
//   - maxParticipants: int (optional, >= 0)
//   - entryFee: number (optional, >= 0)
//   - currency: string (optional, max 10 chars)
//   - division: string (optional, max 100 chars)
//   - seasonId: string (optional, max 128 chars)
//   - ruleConfig: map (optional, max 50 keys)
//   - leagueId: string (optional, max 128 chars, immutable)
//   - leagueName: string (optional, max 100 chars)
//   - managerUserIds: list of strings (optional, max 50 items)
//   - refereeUserIds: list of strings (optional, max 100 items)
//   - scorerUserIds: list of strings (optional, max 100 items)
//   - venueManagerIds: list of strings (optional, max 100 items)
//
// Collection: /leagues/{leagueId}
// Document ID: League UUID string (1-128 chars, matches league.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - name: string (required, 1-100 chars)
//   - description: string (optional, max 5000 chars)
//   - creatorId: string (required, 1-128 chars, immutable)
//   - organizerName: string (optional, max 100 chars)
//   - shareCode: string (required, 4-30 chars, immutable)
//   - venue: string (optional, max 200 chars)
//   - isPublic: bool (required)
//   - sportTypes: list of strings (optional, max 50 items)
//   - tournamentIds: list of strings (optional, max 500 items)
//   - seasonIds: list of strings (optional, max 100 items)
//   - divisions: list of strings (optional, max 100 items)
//   - status: int (optional, 0-10)
//   - statusName: string (optional, max 50 chars)
//   - startDate: timestamp | string (optional, max 50 chars)
//   - endDate: timestamp | string (optional, max 50 chars)
//   - bannerUrl: string (optional, max 2000 chars)
//   - createdAt: timestamp | string (required, max 50 chars, immutable)
//   - pointsConfig: map (optional, max 50 keys)
//   - membershipPolicy: string (optional, max 100 chars)
//   - ownerIds: list of strings (optional, max 50 items)
//   - adminUserIds: list of strings (optional, max 100 items)
//   - registrationManagerIds: list of strings (optional, max 100 items)
//   - financeManagerIds: list of strings (optional, max 100 items)
//   - mediaManagerIds: list of strings (optional, max 100 items)
//   - announcements: list of maps (optional, max 200 items)
//
// Collection: /matches/{matchId}
// Document ID: Match ID string (1-128 chars)
// Fields:
//   - id: string (optional, 1-128 chars, immutable)
//   - sport: string (required, 1-50 chars)
//   - date: timestamp | string (required, max 50 chars)
//   - teamA: string (required, 1-100 chars)
//   - teamB: string (required, 1-100 chars)
//   - scoreA: int (required, >= 0)
//   - scoreB: int (required, >= 0)
//   - winner: string (required, max 100 chars)
//   - details: string (optional, max 20000 chars)
//   - userId: string (optional, max 128 chars, immutable)
//   - tournamentId: string (optional, max 128 chars, immutable)
//   - status: int | string (optional, max 30 chars)
//   - statusReason: string (optional, max 500 chars)
//   - refereeId: string (optional, max 128 chars)
//   - refereeUserIds: list of strings (optional, max 20 items)
//   - assignedScorerId: string (optional, max 128 chars)
//   - scorerUserIds: list of strings (optional, max 20 items)
//   - liveMatchData: map (optional, max 100 keys)
//   - createdAt: timestamp | string (optional, max 50 chars, immutable)
//
// Collection: /teams/{teamId}
// Document ID: Team ID string (1-128 chars, matches team.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - name: string (required, 1-100 chars)
//   - seed: int (optional, >= 1)
//   - playerIds: list of strings (optional, max 100 items)
//   - logoUrl: string (optional, max 2000 chars)
//   - colorHex: string (optional, max 20 chars)
//   - captainId: string (optional, max 128 chars)
//   - userId: string (optional, max 128 chars)
//   - managerId: string (optional, max 128 chars)
//
// Collection: /players/{playerId}
// Document ID: Player ID string (1-128 chars)
// Fields:
//   - id: string (optional, 1-128 chars, immutable)
//   - name: string (required, 1-100 chars)
//   - profilePhotoUrl: string (optional, max 2000 chars)
//   - contact: string (optional, max 50 chars)
//   - seed: int (optional, >= 1)
//   - userId: string (optional, max 128 chars, immutable once set)
//
// Collection: /users/{userId}
// Document ID: User Firebase Auth UID (1-128 chars, matches request.auth.uid)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - email: string (optional, max 254 chars)
//   - displayName: string (optional, max 100 chars)
//   - photoUrl: string (optional, max 2000 chars)
//   - isAnonymous: bool (optional)
//   - authProvider: string (optional, max 50 chars)
//   - createdAt: timestamp | string (optional, max 50 chars, immutable)
//
// Collection: /venues/{venueId}
// Document ID: Venue ID string (1-128 chars, matches venue.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - name: string (required, 1-100 chars)
//   - address: string (optional, max 300 chars)
//   - leagueId: string (optional, max 128 chars)
//   - facilities: list of strings (optional, max 50 items)
//   - supportedSports: list of strings (optional, max 50 items)
//   - playingAreas: list of maps (optional, max 100 items)
//   - managerUserIds: list of strings (optional, max 50 items)
//   - createdAt: timestamp | string (required, max 50 chars, immutable)
//
// Collection: /seasons/{seasonId}
// Document ID: Season ID string (1-128 chars, matches season.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - leagueId: string (required, 1-128 chars, immutable)
//   - name: string (required, 1-100 chars)
//   - startDate: timestamp | string (optional, max 50 chars)
//   - endDate: timestamp | string (optional, max 50 chars)
//   - registrationStart: timestamp | string (optional, max 50 chars)
//   - registrationEnd: timestamp | string (optional, max 50 chars)
//   - status: int | string (optional, max 30 chars)
//   - tournamentIds: list of strings (optional, max 500 items)
//   - rulesConfig: map (optional, max 50 keys)
//   - createdAt: timestamp | string (required, max 50 chars, immutable)
//
// Collection: /registrations/{registrationId}
// Document ID: Registration ID string (1-128 chars, matches registration.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - tournamentId: string (optional, max 128 chars, immutable)
//   - leagueId: string (optional, max 128 chars, immutable)
//   - participantId: string (required, 1-128 chars, immutable)
//   - participantName: string (required, 1-100 chars)
//   - isTeam: bool (required, immutable)
//   - rosterPlayerIds: list of strings (optional, max 100 items)
//   - submittedByUserId: string (required, 1-128 chars, immutable)
//   - status: string (required, in ['pending', 'approved', 'waitlisted', 'rejected', 'withdrawn'])
//   - reviewedByUserId: string (optional, max 128 chars)
//   - reviewNotes: string (optional, max 2000 chars)
//   - entryFee: number (optional, >= 0)
//   - paymentStatus: string (optional, max 30 chars)
//   - submittedAt: timestamp | string (required, max 50 chars, immutable)
//   - reviewedAt: timestamp | string (optional, max 50 chars)
//
// Collection: /disputes/{disputeId}
// Document ID: Dispute ID string (1-128 chars, matches dispute.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - title: string (required, 1-200 chars)
//   - description: string (required, 1-5000 chars)
//   - type: string (required, max 50 chars)
//   - status: string (required, in ['pending', 'under_review', 'resolved', 'rejected', 'appealed'])
//   - tournamentId: string (optional, max 128 chars, immutable)
//   - matchId: string (optional, max 128 chars, immutable)
//   - leagueId: string (optional, max 128 chars, immutable)
//   - submittedByUserId: string (required, 1-128 chars, immutable)
//   - submittedByName: string (optional, max 100 chars)
//   - againstParticipantName: string (optional, max 100 chars)
//   - reviewerUserId: string (optional, max 128 chars)
//   - reviewerName: string (optional, max 100 chars)
//   - resolution: string (optional, max 5000 chars)
//   - evidenceUrls: list of strings (optional, max 20 items)
//   - createdAt: timestamp | string (required, max 50 chars, immutable)
//   - resolvedAt: timestamp | string (optional, max 50 chars)
//
// Collection: /audit_logs/{logId}
// Document ID: Log ID string (1-128 chars, matches log.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable)
//   - actorId: string (required, 1-128 chars, immutable)
//   - actorName: string (optional, max 100 chars)
//   - actorEmail: string (optional, max 254 chars)
//   - action: string (required, 1-100 chars)
//   - targetType: string (required, 1-50 chars)
//   - targetId: string (required, 1-128 chars)
//   - description: string (optional, max 2000 chars)
//   - metadata: map (optional, max 50 keys)
//   - timestamp: timestamp | string (required, max 50 chars, immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Foundational Helper Functions
    // ===============================================================

    // Check if the caller is an authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the authenticated caller owns the resource by matching UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Ensure critical immutable fields cannot be changed on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // RBAC Role Verification Helpers (9-Role Hierarchy)
    // ===============================================================

    // 1. Platform Super Admin (Platform level)
    // Derived strictly from verified Firebase Auth custom claims
    function isSuperAdmin() {
      return isAuthenticated() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('superAdmin' in request.auth.token && request.auth.token.superAdmin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'super_admin')
      );
    }

    // 2. League Owner (League level)
    // Checks creatorId or explicit membership in ownerIds list
    function isLeagueOwner(leagueData) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        leagueData.creatorId == request.auth.uid ||
        ('ownerIds' in leagueData && leagueData.ownerIds is list && request.auth.uid in leagueData.ownerIds)
      );
    }

    // 3. League Administrator (League level)
    // Inherits League Owner; checks membership in adminUserIds list
    function isLeagueAdmin(leagueData) {
      return isLeagueOwner(leagueData) || (
        isAuthenticated() &&
        'adminUserIds' in leagueData &&
        leagueData.adminUserIds is list &&
        request.auth.uid in leagueData.adminUserIds
      );
    }

    // Helper: Safely check if parent league document exists
    function hasLeague(leagueId) {
      return leagueId is string &&
             leagueId.size() > 0 &&
             exists(/databases/$(database)/documents/leagues/$(leagueId));
    }

    // Helper: Fetch parent league document data
    function getLeagueData(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
    }

    // Helper: Check if caller is League Owner by parent League ID
    function isLeagueOwnerById(leagueId) {
      return hasLeague(leagueId) && isLeagueOwner(getLeagueData(leagueId));
    }

    // Helper: Check if caller is League Admin by parent League ID
    function isLeagueAdminById(leagueId) {
      return hasLeague(leagueId) && isLeagueAdmin(getLeagueData(leagueId));
    }

    // 4. Tournament Manager (Tournament level)
    // Checks tournament creatorId, managerUserIds, or admin/owner of parent league
    function isTournamentManager(tournamentData) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        tournamentData.creatorId == request.auth.uid ||
        ('managerUserIds' in tournamentData &&
         tournamentData.managerUserIds is list &&
         request.auth.uid in tournamentData.managerUserIds) ||
        ('leagueId' in tournamentData &&
         tournamentData.leagueId != null &&
         tournamentData.leagueId is string &&
         tournamentData.leagueId != '' &&
         isLeagueAdminById(tournamentData.leagueId))
      );
    }

    // Helper: Safely check if parent tournament document exists
    function hasTournament(tournamentId) {
      return tournamentId is string &&
             tournamentId.size() > 0 &&
             exists(/databases/$(database)/documents/tournaments/$(tournamentId));
    }

    // Helper: Fetch parent tournament document data
    function getTournamentData(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
    }

    // Helper: Check if caller is Tournament Manager by parent Tournament ID
    function isTournamentManagerById(tournamentId) {
      return hasTournament(tournamentId) && isTournamentManager(getTournamentData(tournamentId));
    }

    // Helper: Check if caller is Referee on a parent Tournament by ID
    function isTournamentRefereeById(tournamentId) {
      return hasTournament(tournamentId) && (
        isTournamentManager(getTournamentData(tournamentId)) ||
        ('refereeUserIds' in getTournamentData(tournamentId) &&
         getTournamentData(tournamentId).refereeUserIds is list &&
         request.auth.uid in getTournamentData(tournamentId).refereeUserIds)
      );
    }

    // Helper: Check if caller is Scorer on a parent Tournament by ID
    function isTournamentScorerById(tournamentId) {
      return hasTournament(tournamentId) && (
        isTournamentRefereeById(tournamentId) ||
        ('scorerUserIds' in getTournamentData(tournamentId) &&
         getTournamentData(tournamentId).scorerUserIds is list &&
         request.auth.uid in getTournamentData(tournamentId).scorerUserIds)
      );
    }

    // Helper: Safely check if match document exists
    function hasMatch(matchId) {
      return matchId is string &&
             matchId.size() > 0 &&
             exists(/databases/$(database)/documents/matches/$(matchId));
    }

    // Helper: Fetch match document data
    function getMatchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    // 5. Referee / Match Official (Match level)
    // Inherits Tournament Manager; checks refereeUserIds, refereeId, assignedRefereeId,
    // or parent tournament referee assignment
    function isMatchReferee(data) {
      return isAuthenticated() && (
        isTournamentManager(data) ||
        ('refereeUserIds' in data && data.refereeUserIds is list && request.auth.uid in data.refereeUserIds) ||
        ('refereeId' in data && data.refereeId == request.auth.uid) ||
        ('assignedRefereeId' in data && data.assignedRefereeId == request.auth.uid) ||
        ('tournamentId' in data && data.tournamentId != null && data.tournamentId is string && data.tournamentId != '' &&
         isTournamentRefereeById(data.tournamentId))
      );
    }

    // 6. Scorer (Match level)
    // Inherits Match Referee; checks scorerUserIds, assignedScorerId, scorerId,
    // or parent tournament scorer assignment
    function isMatchScorer(data) {
      return isAuthenticated() && (
        isMatchReferee(data) ||
        ('scorerUserIds' in data && data.scorerUserIds is list && request.auth.uid in data.scorerUserIds) ||
        ('assignedScorerId' in data && data.assignedScorerId == request.auth.uid) ||
        ('scorerId' in data && data.scorerId == request.auth.uid) ||
        ('tournamentId' in data && data.tournamentId != null && data.tournamentId is string && data.tournamentId != '' &&
         isTournamentScorerById(data.tournamentId))
      );
    }

    // 7. Team Manager / Captain (Team level)
    // Checks team creator/manager (userId), captain (captainId), or managerId
    function isTeamManager(teamData) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        ('userId' in teamData && teamData.userId == request.auth.uid) ||
        ('captainId' in teamData && teamData.captainId == request.auth.uid) ||
        ('managerId' in teamData && teamData.managerId == request.auth.uid)
      );
    }

    // 8. Player / Participant (Participant level)
    // Checks personal player profile ownership (player.userId == request.auth.uid)
    function isPlayerOwner(playerData) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        ('userId' in playerData && playerData.userId == request.auth.uid)
      );
    }

    // 9. Spectator / Viewer (Read only)
    // Public read-only access for discoverable sports data (never grants write permissions)
    function isSpectator() {
      return true;
    }

    // Helper: Check if caller can read registration record
    function canReadRegistration(data) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        data.submittedByUserId == request.auth.uid ||
        ('tournamentId' in data && data.tournamentId != null && data.tournamentId is string && data.tournamentId != '' &&
         isTournamentManagerById(data.tournamentId)) ||
        ('leagueId' in data && data.leagueId != null && data.leagueId is string && data.leagueId != '' &&
         isLeagueAdminById(data.leagueId))
      );
    }

    // Helper: Check if caller can review / approve registration record
    function canManageRegistration(data) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        ('tournamentId' in data && data.tournamentId != null && data.tournamentId is string && data.tournamentId != '' &&
         isTournamentManagerById(data.tournamentId)) ||
        ('leagueId' in data && data.leagueId != null && data.leagueId is string && data.leagueId != '' &&
         isLeagueAdminById(data.leagueId))
      );
    }

    // Helper: Check if caller can read dispute record
    function canReadDispute(data) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        data.submittedByUserId == request.auth.uid ||
        ('tournamentId' in data && data.tournamentId != null && data.tournamentId is string && data.tournamentId != '' &&
         isTournamentScorerById(data.tournamentId)) ||
        ('matchId' in data && data.matchId != null && data.matchId is string && data.matchId != '' &&
         hasMatch(data.matchId) && isMatchScorer(getMatchData(data.matchId))) ||
        ('leagueId' in data && data.leagueId != null && data.leagueId is string && data.leagueId != '' &&
         isLeagueAdminById(data.leagueId))
      );
    }

    // Helper: Check if caller can review / resolve dispute record
    function canReviewDispute(data) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        ('tournamentId' in data && data.tournamentId != null && data.tournamentId is string && data.tournamentId != '' &&
         isTournamentRefereeById(data.tournamentId)) ||
        ('matchId' in data && data.matchId != null && data.matchId is string && data.matchId != '' &&
         hasMatch(data.matchId) && isMatchReferee(getMatchData(data.matchId))) ||
        ('leagueId' in data && data.leagueId != null && data.leagueId is string && data.leagueId != '' &&
         isLeagueAdminById(data.leagueId))
      );
    }

    // ===============================================================
    // Domain Validators (Enforced on BOTH Create and Update)
    // ===============================================================

    // Domain validator for /tournaments/{tournamentId}
    function isValidTournament(data) {
      let allowedFields = [
        'id', 'name', 'sportType', 'format', 'formatName',
        'participants', 'matches', 'status', 'statusName', 'seeded',
        'createdAt', 'creatorId', 'shareCode', 'participantUserIds',
        'description', 'organizerName', 'venue', 'venueId', 'startDate', 'endDate',
        'bannerUrl', 'isPublic', 'registrationDeadline', 'isTeamTournament',
        'maxSquadSize', 'minParticipants', 'maxParticipants', 'entryFee',
        'currency', 'division', 'seasonId', 'ruleConfig', 'leagueId', 'leagueName',
        'managerUserIds', 'refereeUserIds', 'scorerUserIds', 'venueManagerIds'
      ];

      let requiredFields = [
        'id', 'name', 'sportType', 'format', 'status',
        'creatorId', 'shareCode', 'isPublic', 'participants', 'matches', 'createdAt'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.sportType is string && data.sportType.size() >= 1 && data.sportType.size() <= 50 &&
             data.format is int && data.format >= 0 && data.format <= 10 &&
             data.status is int && data.status >= 0 && data.status <= 10 &&
             data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.shareCode is string && data.shareCode.size() >= 4 && data.shareCode.size() <= 30 &&
             data.isPublic is bool &&
             data.participants is list && data.participants.size() <= 200 &&
             data.matches is list && data.matches.size() <= 1000 &&
             (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('formatName' in data) || data.formatName == null || (data.formatName is string && data.formatName.size() <= 50)) &&
             (!('statusName' in data) || data.statusName == null || (data.statusName is string && data.statusName.size() <= 50)) &&
             (!('seeded' in data) || data.seeded == null || data.seeded is bool) &&
             (!('participantUserIds' in data) || (data.participantUserIds is list && data.participantUserIds.size() <= 500)) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 5000)) &&
             (!('organizerName' in data) || data.organizerName == null || (data.organizerName is string && data.organizerName.size() <= 100)) &&
             (!('venue' in data) || data.venue == null || (data.venue is string && data.venue.size() <= 200)) &&
             (!('venueId' in data) || data.venueId == null || (data.venueId is string && data.venueId.size() <= 128)) &&
             (!('startDate' in data) || data.startDate == null || data.startDate is timestamp || (data.startDate is string && data.startDate.size() <= 50)) &&
             (!('endDate' in data) || data.endDate == null || data.endDate is timestamp || (data.endDate is string && data.endDate.size() <= 50)) &&
             (!('bannerUrl' in data) || data.bannerUrl == null || (data.bannerUrl is string && data.bannerUrl.size() <= 2000)) &&
             (!('registrationDeadline' in data) || data.registrationDeadline == null || data.registrationDeadline is timestamp || (data.registrationDeadline is string && data.registrationDeadline.size() <= 50)) &&
             (!('isTeamTournament' in data) || data.isTeamTournament == null || data.isTeamTournament is bool) &&
             (!('maxSquadSize' in data) || data.maxSquadSize == null || (data.maxSquadSize is int && data.maxSquadSize >= 1 && data.maxSquadSize <= 1000)) &&
             (!('minParticipants' in data) || data.minParticipants == null || (data.minParticipants is int && data.minParticipants >= 0)) &&
             (!('maxParticipants' in data) || data.maxParticipants == null || (data.maxParticipants is int && data.maxParticipants >= 0)) &&
             (!('entryFee' in data) || data.entryFee == null || ((data.entryFee is int || data.entryFee is float) && data.entryFee >= 0)) &&
             (!('currency' in data) || data.currency == null || (data.currency is string && data.currency.size() <= 10)) &&
             (!('division' in data) || data.division == null || (data.division is string && data.division.size() <= 100)) &&
             (!('seasonId' in data) || data.seasonId == null || (data.seasonId is string && data.seasonId.size() <= 128)) &&
             (!('ruleConfig' in data) || data.ruleConfig == null || (data.ruleConfig is map && data.ruleConfig.size() <= 50)) &&
             (!('leagueId' in data) || data.leagueId == null || (data.leagueId is string && data.leagueId.size() <= 128)) &&
             (!('leagueName' in data) || data.leagueName == null || (data.leagueName is string && data.leagueName.size() <= 100)) &&
             (!('managerUserIds' in data) || (data.managerUserIds is list && data.managerUserIds.size() <= 50)) &&
             (!('refereeUserIds' in data) || (data.refereeUserIds is list && data.refereeUserIds.size() <= 100)) &&
             (!('scorerUserIds' in data) || (data.scorerUserIds is list && data.scorerUserIds.size() <= 100)) &&
             (!('venueManagerIds' in data) || (data.venueManagerIds is list && data.venueManagerIds.size() <= 100));
    }

    // Domain validator for /leagues/{leagueId}
    function isValidLeague(data, leagueId) {

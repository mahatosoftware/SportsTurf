    // Domain validator for /registrations/{registrationId}
    function isValidRegistration(data, registrationId) {
      let allowedFields = [
        'id', 'tournamentId', 'leagueId', 'participantId', 'participantName',
        'isTeam', 'rosterPlayerIds', 'submittedByUserId', 'status',
        'reviewedByUserId', 'reviewNotes', 'entryFee', 'paymentStatus',
        'submittedAt', 'reviewedAt'
      ];

      let requiredFields = [
        'id', 'participantId', 'participantName', 'isTeam',
        'submittedByUserId', 'status', 'submittedAt'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == registrationId &&
             data.participantId is string && data.participantId.size() >= 1 && data.participantId.size() <= 128 &&
             data.participantName is string && data.participantName.size() >= 1 && data.participantName.size() <= 100 &&
             data.isTeam is bool &&
             data.submittedByUserId is string && data.submittedByUserId.size() >= 1 && data.submittedByUserId.size() <= 128 &&
             data.status is string && data.status in ['pending', 'approved', 'waitlisted', 'rejected', 'withdrawn'] &&
             (data.submittedAt is timestamp || (data.submittedAt is string && data.submittedAt.size() <= 50)) &&
             (!('tournamentId' in data) || data.tournamentId == null || (data.tournamentId is string && data.tournamentId.size() <= 128)) &&
             (!('leagueId' in data) || data.leagueId == null || (data.leagueId is string && data.leagueId.size() <= 128)) &&
             (!('rosterPlayerIds' in data) || (data.rosterPlayerIds is list && data.rosterPlayerIds.size() <= 100)) &&
             (!('reviewedByUserId' in data) || data.reviewedByUserId == null || (data.reviewedByUserId is string && data.reviewedByUserId.size() <= 128)) &&
             (!('reviewNotes' in data) || data.reviewNotes == null || (data.reviewNotes is string && data.reviewNotes.size() <= 2000)) &&
             (!('entryFee' in data) || data.entryFee == null || ((data.entryFee is int || data.entryFee is float) && data.entryFee >= 0)) &&
             (!('paymentStatus' in data) || data.paymentStatus == null || (data.paymentStatus is string && data.paymentStatus.size() <= 30)) &&
             (!('reviewedAt' in data) || data.reviewedAt == null || data.reviewedAt is timestamp || (data.reviewedAt is string && data.reviewedAt.size() <= 50));
    }

    // Domain validator for /disputes/{disputeId}
    function isValidDispute(data, disputeId) {
      let allowedFields = [
        'id', 'title', 'description', 'type', 'status',
        'tournamentId', 'matchId', 'leagueId', 'submittedByUserId',
        'submittedByName', 'againstParticipantName', 'reviewerUserId',
        'reviewerName', 'resolution', 'evidenceUrls', 'createdAt', 'resolvedAt'
      ];

      let requiredFields = [
        'id', 'title', 'description', 'type', 'status',
        'submittedByUserId', 'createdAt'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == disputeId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 5000 &&
             data.type is string && data.type.size() >= 1 && data.type.size() <= 50 &&
             data.status is string && data.status in ['pending', 'under_review', 'resolved', 'rejected', 'appealed'] &&
             data.submittedByUserId is string && data.submittedByUserId.size() >= 1 && data.submittedByUserId.size() <= 128 &&
             (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('tournamentId' in data) || data.tournamentId == null || (data.tournamentId is string && data.tournamentId.size() <= 128)) &&
             (!('matchId' in data) || data.matchId == null || (data.matchId is string && data.matchId.size() <= 128)) &&
             (!('leagueId' in data) || data.leagueId == null || (data.leagueId is string && data.leagueId.size() <= 128)) &&
             (!('submittedByName' in data) || data.submittedByName == null || (data.submittedByName is string && data.submittedByName.size() <= 100)) &&
             (!('againstParticipantName' in data) || data.againstParticipantName == null || (data.againstParticipantName is string && data.againstParticipantName.size() <= 100)) &&
             (!('reviewerUserId' in data) || data.reviewerUserId == null || (data.reviewerUserId is string && data.reviewerUserId.size() <= 128)) &&
             (!('reviewerName' in data) || data.reviewerName == null || (data.reviewerName is string && data.reviewerName.size() <= 100)) &&
             (!('resolution' in data) || data.resolution == null || (data.resolution is string && data.resolution.size() <= 5000)) &&
             (!('evidenceUrls' in data) || (data.evidenceUrls is list && data.evidenceUrls.size() <= 20)) &&
             (!('resolvedAt' in data) || data.resolvedAt == null || data.resolvedAt is timestamp || (data.resolvedAt is string && data.resolvedAt.size() <= 50));
    }

    // Domain validator for /audit_logs/{logId}
    function isValidAuditLog(data, logId) {
      let allowedFields = [
        'id', 'actorId', 'actorName', 'actorEmail', 'action',
        'targetType', 'targetId', 'description', 'metadata', 'timestamp'
      ];

      let requiredFields = [
        'id', 'actorId', 'action', 'targetType', 'targetId', 'timestamp'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == logId &&
             data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 100 &&
             data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 50 &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             (data.timestamp is timestamp || (data.timestamp is string && data.timestamp.size() <= 50)) &&
             (!('actorName' in data) || data.actorName == null || (data.actorName is string && data.actorName.size() <= 100)) &&
             (!('actorEmail' in data) || data.actorEmail == null || (data.actorEmail is string && data.actorEmail.size() <= 254)) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000)) &&
             (!('metadata' in data) || data.metadata == null || (data.metadata is map && data.metadata.size() <= 50));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // ---------------------------------------------------------------
    // 1. Tournaments Collection (/tournaments/{tournamentId})
    // ---------------------------------------------------------------
    match /tournaments/{tournamentId} {

      // READ: Role 9 (Spectator/Viewer)
      allow read: if isSpectator();

      // CREATE: Tournament Creator, Manager (in managerUserIds), League Admin, or Super Admin
      allow create: if isAuthenticated() &&
                       (
                         request.resource.data.creatorId == request.auth.uid ||
                         ('managerUserIds' in request.resource.data &&
                          request.resource.data.managerUserIds is list &&
                          request.auth.uid in request.resource.data.managerUserIds) ||
                         isTournamentManager(request.resource.data) ||
                         isSuperAdmin()
                       ) &&
                       request.resource.data.id == tournamentId &&
                       isValidTournament(request.resource.data);

      // UPDATE:
      // Tier A: Tournament Manager / League Admin / Super Admin
      // Tier B: Scorer / Match Referee (limited strictly to matches and status)
      allow update: if isAuthenticated() && (
        (
          isTournamentManager(resource.data) &&
          isValidTournament(request.resource.data) &&
          areImmutableFieldsUnchanged(['id', 'creatorId', 'createdAt', 'shareCode'])
        ) ||
        (
          isMatchScorer(resource.data) &&
          isValidTournament(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matches', 'status', 'statusName'])
        )
      );

      // DELETE: Tournament Creator, Parent League Owner, or Super Admin
      allow delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        isSuperAdmin() ||
        ('leagueId' in resource.data &&
         resource.data.leagueId != null &&
         resource.data.leagueId is string &&
         resource.data.leagueId != '' &&
         isLeagueOwnerById(resource.data.leagueId))
      );
    }

    // ---------------------------------------------------------------
    // 2. Leagues Collection (/leagues/{leagueId})
    // ---------------------------------------------------------------
    match /leagues/{leagueId} {

      // READ: Role 9 (Spectator/Viewer)
      allow read: if isSpectator();

      // CREATE: Role 2 (League Owner: creatorId or in ownerIds) or Super Admin
      allow create: if isAuthenticated() &&
                       (
                         request.resource.data.creatorId == request.auth.uid ||
                         ('ownerIds' in request.resource.data &&
                          request.resource.data.ownerIds is list &&
                          request.auth.uid in request.resource.data.ownerIds) ||
                         isSuperAdmin()
                       ) &&
                       request.resource.data.id == leagueId &&
                       isValidLeague(request.resource.data, leagueId);

      // UPDATE:
      // Tier A: League Owner / Super Admin (full configuration, all non-immutable fields)
      // Tier B: League Admin (operational updates only, cannot escalate permissions)
      allow update: if isAuthenticated() && (
        (
          isLeagueOwner(resource.data) &&
          isValidLeague(request.resource.data, leagueId) &&
          areImmutableFieldsUnchanged(['id', 'creatorId', 'createdAt', 'shareCode'])
        ) ||
        (
          isLeagueAdmin(resource.data) &&
          isValidLeague(request.resource.data, leagueId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'organizerName', 'venue', 'isPublic',
            'sportTypes', 'tournamentIds', 'seasonIds', 'divisions',
            'status', 'statusName', 'startDate', 'endDate', 'bannerUrl',
            'pointsConfig', 'membershipPolicy', 'registrationManagerIds',
            'financeManagerIds', 'mediaManagerIds', 'announcements'
          ])
        )
      );

      // DELETE: Only League Owner or Super Admin can delete a league
      allow delete: if isAuthenticated() && isLeagueOwner(resource.data);
    }

    // ---------------------------------------------------------------
    // 3. Matches Collection (/matches/{matchId})
    // ---------------------------------------------------------------
    match /matches/{matchId} {

      // READ: Role 9 (Spectator/Viewer)
      allow read: if isSpectator();

      // CREATE: Authenticated match creator, Tournament Manager, or Super Admin
      allow create: if isAuthenticated() &&
                       (
                         request.resource.data.userId == request.auth.uid ||
                         !('userId' in request.resource.data) ||
                         request.resource.data.userId == null ||
                         ('tournamentId' in request.resource.data &&
                          request.resource.data.tournamentId != null &&
                          isTournamentManagerById(request.resource.data.tournamentId)) ||
                         isSuperAdmin()
                       ) &&
                       isValidMatchResult(request.resource.data, matchId);

      // UPDATE:
      // Tier A: Match Creator / Tournament Manager / Super Admin
      // Tier B: Referee (scores, status, statusReason for walkovers/disputes, live data)
      // Tier C: Scorer (live scoring fields and status only)
      allow update: if isAuthenticated() && (
        (
          (
            isSuperAdmin() ||
            (resource.data.userId == request.auth.uid) ||
            ('tournamentId' in resource.data &&
             resource.data.tournamentId != null &&
             resource.data.tournamentId is string &&
             resource.data.tournamentId != '' &&
             isTournamentManagerById(resource.data.tournamentId))
          ) &&
          isValidMatchResult(request.resource.data, matchId) &&
          areImmutableFieldsUnchanged(['id', 'userId', 'createdAt'])
        ) ||
        (
          isMatchReferee(resource.data) &&
          isValidMatchResult(request.resource.data, matchId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'scoreA', 'scoreB', 'winner', 'status', 'statusReason', 'details', 'liveMatchData'
          ])
        ) ||
        (
          isMatchScorer(resource.data) &&
          isValidMatchResult(request.resource.data, matchId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'scoreA', 'scoreB', 'winner', 'details', 'liveMatchData', 'status'
          ])
        )
      );

      // DELETE: Match Creator, Tournament Manager, or Super Admin
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        ('tournamentId' in resource.data &&
         resource.data.tournamentId != null &&
         resource.data.tournamentId is string &&
         resource.data.tournamentId != '' &&
         isTournamentManagerById(resource.data.tournamentId))
      );
    }

    // ---------------------------------------------------------------
    // 4. Teams Collection (/teams/{teamId})
    // ---------------------------------------------------------------
    match /teams/{teamId} {

      // READ: Role 9 (Spectator/Viewer)
      allow read: if isSpectator();

      // CREATE: Authenticated user creating team, Team Manager / Captain, or Super Admin
      allow create: if isAuthenticated() &&
                       (
                         !('userId' in request.resource.data) ||
                         request.resource.data.userId == null ||
                         request.resource.data.userId == request.auth.uid ||
                         isTeamManager(request.resource.data) ||
                         isSuperAdmin()
                       ) &&
                       isValidTeam(request.resource.data, teamId);

      // UPDATE: Team Manager / Captain, creator/owner, or Super Admin
      allow update: if isAuthenticated() &&
                       (
                         !('userId' in resource.data) ||
                         resource.data.userId == null ||
                         resource.data.userId == request.auth.uid ||
                         isTeamManager(resource.data) ||
                         isSuperAdmin()
                       ) &&
                       isValidTeam(request.resource.data, teamId) &&
                       areImmutableFieldsUnchanged(['id']);

      // DELETE: Team Manager / Captain, creator/owner, or Super Admin
      allow delete: if isAuthenticated() &&
                       (
                         !('userId' in resource.data) ||
                         resource.data.userId == null ||
                         resource.data.userId == request.auth.uid ||
                         isTeamManager(resource.data) ||
                         isSuperAdmin()
                       );
    }

    // ---------------------------------------------------------------
    // 5. Players Collection (/players/{playerId})
    // ---------------------------------------------------------------
    match /players/{playerId} {

      // READ: Role 9 (Spectator/Viewer)
      allow read: if isSpectator();

      // CREATE: Authenticated user creating profile
      allow create: if isAuthenticated() &&
                       (
                         !('userId' in request.resource.data) ||
                         request.resource.data.userId == null ||
                         request.resource.data.userId == request.auth.uid ||
                         isSuperAdmin()
                       ) &&
                       isValidPlayer(request.resource.data, playerId);

      // UPDATE: Role 8 (Player Profile Owner), or authenticated user if unlinked profile
      allow update: if isAuthenticated() && (
        (
          'userId' in resource.data &&
          resource.data.userId != null &&
          isPlayerOwner(resource.data) &&
          isValidPlayer(request.resource.data, playerId) &&
          areImmutableFieldsUnchanged(['id', 'userId'])
        ) ||
        (
          (!('userId' in resource.data) || resource.data.userId == null) &&
          isValidPlayer(request.resource.data, playerId) &&
          areImmutableFieldsUnchanged(['id']) &&
          (
            !('userId' in request.resource.data) ||
            request.resource.data.userId == null ||
            request.resource.data.userId == request.auth.uid ||
            isSuperAdmin()
          )
        )
      );

      // DELETE: Player Profile Owner, or authenticated organizer if unlinked
      allow delete: if isAuthenticated() && (
        isPlayerOwner(resource.data) ||
        !('userId' in resource.data) ||
        resource.data.userId == null
      );
    }

    // ---------------------------------------------------------------
    // 6. Users Collection (/users/{userId})
    // ---------------------------------------------------------------
    match /users/{userId} {

      // READ: Strictly limited to profile owner or Super Admin (PII protection)
      allow read: if isOwner(userId) || isSuperAdmin();

      // CREATE: Only the account owner or Super Admin
      allow create: if (isOwner(userId) || isSuperAdmin()) &&
                       request.resource.data.id == userId &&
                       isValidUser(request.resource.data);

      // UPDATE: Only the account owner or Super Admin
      allow update: if (isOwner(userId) || isSuperAdmin()) &&
                       isValidUser(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);

      // DELETE: Only the account owner or Super Admin
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // 7. Venues Collection (/venues/{venueId})
    // ---------------------------------------------------------------
    match /venues/{venueId} {

      // READ: Role 9 (Spectator/Viewer)
      // Publicly readable so players and spectators can view venue courts/arenas
      allow read: if isSpectator();

      // CREATE: Super Admin, assigned Venue Manager, or parent League Admin/Owner
      allow create: if isAuthenticated() &&
                       request.resource.data.id == venueId &&
                       (
                         isSuperAdmin() ||
                         ('managerUserIds' in request.resource.data &&
                          request.resource.data.managerUserIds is list &&
                          request.auth.uid in request.resource.data.managerUserIds) ||
                         ('leagueId' in request.resource.data &&
                          request.resource.data.leagueId != null &&
                          request.resource.data.leagueId is string &&
                          request.resource.data.leagueId != '' &&
                          isLeagueAdminById(request.resource.data.leagueId))
                       ) &&
                       isValidVenue(request.resource.data, venueId);

      // UPDATE: Super Admin, assigned Venue Manager, or parent League Admin/Owner
      allow update: if isAuthenticated() &&
                       (
                         isSuperAdmin() ||
                         ('managerUserIds' in resource.data &&
                          resource.data.managerUserIds is list &&
                          request.auth.uid in resource.data.managerUserIds) ||
                         ('leagueId' in resource.data &&
                          resource.data.leagueId != null &&
                          resource.data.leagueId is string &&
                          resource.data.leagueId != '' &&
                          isLeagueAdminById(resource.data.leagueId))
                       ) &&
                       isValidVenue(request.resource.data, venueId) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);

      // DELETE: Super Admin or parent League Owner
      allow delete: if isAuthenticated() &&
                       (
                         isSuperAdmin() ||
                         ('leagueId' in resource.data &&
                          resource.data.leagueId != null &&
                          resource.data.leagueId is string &&
                          resource.data.leagueId != '' &&
                          isLeagueOwnerById(resource.data.leagueId))
                       );
    }

    // ---------------------------------------------------------------
    // 8. Seasons Collection (/seasons/{seasonId})
    // ---------------------------------------------------------------
    match /seasons/{seasonId} {

      // READ: Role 9 (Spectator/Viewer)
      // Publicly readable for season schedule and standings discovery
      allow read: if isSpectator();

      // CREATE: Super Admin or parent League Admin/Owner
      allow create: if isAuthenticated() &&
                       request.resource.data.id == seasonId &&
                       (
                         isSuperAdmin() ||
                         isLeagueAdminById(request.resource.data.leagueId)
                       ) &&
                       isValidSeason(request.resource.data, seasonId);

      // UPDATE: Super Admin or parent League Admin/Owner
      allow update: if isAuthenticated() &&
                       (
                         isSuperAdmin() ||
                         isLeagueAdminById(resource.data.leagueId)
                       ) &&
                       isValidSeason(request.resource.data, seasonId) &&
                       areImmutableFieldsUnchanged(['id', 'leagueId', 'createdAt']);

      // DELETE: Super Admin or parent League Owner
      allow delete: if isAuthenticated() &&
                       (
                         isSuperAdmin() ||
                         isLeagueOwnerById(resource.data.leagueId)
                       );
    }

    // ---------------------------------------------------------------
    // 9. Registrations Collection (/registrations/{registrationId})
    // ---------------------------------------------------------------
    match /registrations/{registrationId} {

      // READ: Submitter, Tournament Manager, League Admin/Owner, or Super Admin
      allow read: if canReadRegistration(resource.data);

      // CREATE: Authenticated user submitting their own registration (pending status) or Super Admin
      allow create: if isAuthenticated() &&
                       (
                         request.resource.data.submittedByUserId == request.auth.uid ||
                         isSuperAdmin()
                       ) &&
                       request.resource.data.id == registrationId &&
                       (request.resource.data.status == 'pending' || isSuperAdmin()) &&
                       isValidRegistration(request.resource.data, registrationId);

      // UPDATE:
      // Case A: Tournament Manager, League Admin/Owner, or Super Admin (review/decision)
      // Case B: Submitter withdrawing registration (status must become 'withdrawn')
      allow update: if isAuthenticated() && (
        (
          canManageRegistration(resource.data) &&
          isValidRegistration(request.resource.data, registrationId) &&
          areImmutableFieldsUnchanged(['id', 'submittedByUserId', 'submittedAt', 'participantId', 'isTeam', 'tournamentId', 'leagueId'])
        ) ||
        (
          resource.data.submittedByUserId == request.auth.uid &&
          isValidRegistration(request.resource.data, registrationId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'withdrawn'
        )
      );

      // DELETE: Platform Super Admin, parent League Owner, or parent Tournament Manager
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('leagueId' in resource.data &&
         resource.data.leagueId != null &&
         resource.data.leagueId is string &&
         resource.data.leagueId != '' &&
         isLeagueOwnerById(resource.data.leagueId)) ||
        ('tournamentId' in resource.data &&
         resource.data.tournamentId != null &&
         resource.data.tournamentId is string &&
         resource.data.tournamentId != '' &&
         isTournamentManagerById(resource.data.tournamentId))
      );
    }

    // ---------------------------------------------------------------
    // 10. Disputes Collection (/disputes/{disputeId})
    // ---------------------------------------------------------------
    match /disputes/{disputeId} {

      // READ: Submitter, Referee/Scorer, Tournament Manager, League Admin/Owner, or Super Admin
      allow read: if canReadDispute(resource.data);

      // CREATE: Authenticated user submitting dispute (pending status) or Super Admin
      allow create: if isAuthenticated() &&
                       (
                         request.resource.data.submittedByUserId == request.auth.uid ||
                         isSuperAdmin()
                       ) &&
                       request.resource.data.id == disputeId &&
                       (request.resource.data.status == 'pending' || isSuperAdmin()) &&
                       isValidDispute(request.resource.data, disputeId);

      // UPDATE: Match Referee, Tournament Manager, League Admin/Owner, or Super Admin
      allow update: if isAuthenticated() &&
                       canReviewDispute(resource.data) &&
                       isValidDispute(request.resource.data, disputeId) &&
                       areImmutableFieldsUnchanged(['id', 'submittedByUserId', 'createdAt', 'tournamentId', 'matchId', 'leagueId']);

      // DELETE: Super Admin, parent League Owner, or parent Tournament Creator
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('leagueId' in resource.data &&
         resource.data.leagueId != null &&
         resource.data.leagueId is string &&
         resource.data.leagueId != '' &&
         isLeagueOwnerById(resource.data.leagueId)) ||
        ('tournamentId' in resource.data &&
         resource.data.tournamentId != null &&
         resource.data.tournamentId is string &&
         resource.data.tournamentId != '' &&
         isTournamentManagerById(resource.data.tournamentId))
      );
    }

    // ---------------------------------------------------------------
    // 11. Audit Logs Collection (/audit_logs/{logId})
    // ---------------------------------------------------------------
    match /audit_logs/{logId} {

      // READ: Strictly Super Admin only (protects platform audit trail, actor emails, and IP/meta)
      allow read: if isSuperAdmin();

      // CREATE: Authenticated actor writing their own log entry or Super Admin
      allow create: if isAuthenticated() &&
                       (
                         request.resource.data.actorId == request.auth.uid ||
                         isSuperAdmin()
                       ) &&
                       request.resource.data.id == logId &&
                       isValidAuditLog(request.resource.data, logId);

      // UPDATE: STRICTLY DENIED - Audit logs are append-only and tamper-proof
      allow update: if false;

      // DELETE: Super Admin only (for data retention / compliance cleanup)
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // Default Deny Catch-All
    // ===============================================================
    // Deny all reads and writes to unspecified collections or paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
